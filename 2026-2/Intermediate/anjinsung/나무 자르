#include <iostream>
#include <algorithm>
#include <vector>

using namespace std;

int main() {
	int n, m;
	cin >> n >> m;
	vector<int> tree(n);
	for (int i = 0; i < n; i++) {
		cin >> tree[i];
	}

	int low = 0, high = *max_element(tree.begin(), tree.end());
	int ans = 0;

	while (low <= high) {
		int mid = low + (high - low) / 2;
		long long sum = 0;
		for (auto t : tree) {
			if (t > mid) sum += t - mid;
		}

		if (sum >= m) {
			ans = mid;
			low = mid + 1;
		}
		else {
			high = mid - 1;
		}
	}

	cout << ans;
}
