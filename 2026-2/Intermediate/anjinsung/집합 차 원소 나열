#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
	int n, m;
	cin >> n >> m;
	vector<int> v1;
	vector<int> v2;
	vector<int> ans;

	while (n--) {
		int tmp;
		cin >> tmp;
		v1.push_back(tmp);
	}

	while (m--) {
		int tmp;
		cin >> tmp;
		v2.push_back(tmp);
	}

	sort(v2.begin(), v2.end());

	for (auto a : v1) {
		if (binary_search(v2.begin(), v2.end(), a) == false) {
			ans.push_back(a);
		}
	}
	
	sort(ans.begin(), ans.end());

	cout << ans.size() << "\n";
	for (auto e : ans) {
		cout << e << " ";
	}
}
