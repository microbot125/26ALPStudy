#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
	int n;
	cin >> n;
	vector<int> v(n);
	for (int i = 0; i < n; i++) {
		cin >> v[i];
	}
	vector<int> dp(n);
	dp[n - 1] = v[n - 1];
	int ans = v[n - 1];

	for (int i = n-2; i >= 0; i--) {
		dp[i] = max(v[i], v[i] + dp[i+1]);
		ans = max(ans, dp[i]);
	}
	cout << ans;
}
